<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<UserSecretsId>ce16be3e-9d06-4021-8d07-83db69238739</UserSecretsId>
		<DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
	</PropertyGroup>

	<ItemGroup>
		<!-- Системные службы Windows и Linux -->
		<PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.13" />
		<PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.13" />

		<!-- CLI: Библиотека McMaster -->
		<PackageReference Include="McMaster.Extensions.CommandLineUtils" Version="4.1.1" />

		<!-- Валидация -->
		<PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.2.0" />
		<PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.24.2-preview.1" />

		<!-- Swagger UI и генератор документации (без конфликта Microsoft.OpenApi) -->
		<PackageReference Include="Swashbuckle.AspNetCore" Version="7.2.0" />

		<!-- Файловая система -->
		<PackageReference Include="System.IO.Abstractions" Version="22.2.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\BSL.Implementation\BSL.Implementation.csproj" />
		<ProjectReference Include="..\BSL.Models\BSL.Models.csproj" />
		<ProjectReference Include="..\BSL.Security\BSL.Security.csproj" />
	</ItemGroup>

</Project>